{
  "name": "mohammad-event-management-prisma",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "prisma": "^6.19.2"
  },
  "devDependencies": {
    "dotenv-cli": "^6.0.0"
  },
  "scripts": {
    "generate": "dotenv -e server/.env -- prisma generate --schema prisma/schema.prisma",
    "generate:all": "npm run generate",
    "postinstall": "echo 'Skipping automatic prisma generate at root. Run `npm run generate` to generate clients locally.'",
    "sync:prisma": "./scripts/sync_prisma.sh"
  }
}
