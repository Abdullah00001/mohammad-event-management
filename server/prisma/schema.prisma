generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────

enum AccountStatus {
  ACTIVE
  VIEW_ONLY
  HIBERNATED
  BLOCKED
}

enum Role {
  USER
  ADMIN
}

enum EventRole {
  HOST
  TRAVELER
}

enum Provider {
  MANUAL
  GOOGLE
  APPLE
}

enum Gender {
  MALE
  FEMALE
}

enum FriendshipStatus {
  ACCEPTED
  PENDING
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  DELETED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  PAYMENT_FAILED
}

enum NotificationType {
  EVENT_JOIN
  EVENT_LEAVE
  HOST_REMOVED_USER
  WAIT_LIST_ACCEPTED
  EVENT_COMPLETED
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  SPOT_OPENED
  EVENT_NEARBY
  CHAT_MESSAGE
  POD_MESSAGE
  POD_INVITE
}


enum StrikeReason {
  LATE_CANCELLATION   // user cancelled within 6 h window
  NO_SHOW             // host confirmed absence in journal
  MANUAL_ADMIN        // admin applied / reversed a strike manually
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ─── Core User ────────────────────────────────────────────────────

model User {
  id                   String      @id @default(uuid())
  email                String      @unique
  password             String?
  isVerified           Boolean     @default(false)
  accountStatus        AccountStatus @default(ACTIVE)
  role                 Role        @default(USER)
  provider             Provider    @default(MANUAL)
  providerId           String?

  // Strike & penalty system
  strikeCount          Int         @default(0)
  penaltyEndDate       DateTime?

  // Attendance streak (for 30-day strike reset mechanic)
  lastEventAttendedDate DateTime?
  attendanceStreakDays  Int        @default(0)

  // Premium
  isPremium            Boolean     @default(false)
  premiumUntil         DateTime?
  isProfileSetup       Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  stripeCustomerId String? @unique

  // Relations
  profile              Profile?
  userTraits           UserTraits?
  userPreference       UserPreference?
  sentRequests         Friends[]   @relation("SenderRelation")
  receivedRequests     Friends[]   @relation("ReceiverRelation")
  blockedUsers         BlockList[] @relation("BlockerRelation")
  blockedBy            BlockList[] @relation("BlockedRelation")
  eventParticipants    EventParticipants[]
  conversationsAsA     Conversation[]      @relation("ConversationUserA")
  conversationsAsB     Conversation[]      @relation("ConversationUserB")
  conversationSettings ConversationSettings[]
  sentMessages         Message[]           @relation("SentMessages")
  sentEventMessages    EventMessage[]      @relation("SentEventMessages")
  notifications        Notification[]

  orcaGraceToken       OrcaGraceToken?
  travelMode           UserTravelMode?
  devices              Device[]
  waitLists            WaitList[]

  // Pod invites received
  podInvites           PodInvite[]

  @@index([role])
  @@index([accountStatus])
  @@index([isPremium])
}

// ─── Profile & Traits ─────────────────────────────────────────────

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String?
  age              Int?
  gender           Gender?
  location         String?
  avatar           String?
  cover            String?
  bio              String?
  profileInterest  String[] @default([])
  countryVisited   String[] @default([])

  // Passport Stamp Badge — derived from user.isPremium (no extra field needed)
  // Frontend reads user.isPremium to show/hide badge

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Interest {
  id             String   @id @default(uuid())
  interestName   String   @unique
  interestIcon   String
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([interestName])
}

model UserTraits {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  energyScore    Int
  curiosityScore Int
  rhythmScore    Int
  createdAt      DateTime @default(now())

  @@index([energyScore, curiosityScore, rhythmScore])
}

model UserPreference {
  id                  String  @id @default(uuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotification   Boolean @default(true)
  eventReminders      Boolean @default(true)
  friendRequest       Boolean @default(true)
}

// ─── Social ───────────────────────────────────────────────────────

model Friends {
  id         String           @id @default(uuid())
  senderId   String
  sender     User             @relation("SenderRelation", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User             @relation("ReceiverRelation", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FriendshipStatus
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([senderId, receiverId])
}

model BlockList {
  id            String   @id @default(uuid())
  blockerId     String
  blocker       User     @relation("BlockerRelation", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUserId String
  blockedUser   User     @relation("BlockedRelation", fields: [blockedUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([blockerId, blockedUserId])
}

// ─── Events / Pods ────────────────────────────────────────────────

model Event {
  id                   String      @id @default(uuid())
  eventName            String
  description          String
  startDate            DateTime
  startTime            String
  endTime              String
  maxParticipantsCount Int         @default(10)
  eventStatus          EventStatus @default(UPCOMING)
  lat                  Float
  long                 Float
  deletedAt            DateTime?
  interests        String[]    @default([])

  // Private Pod (Reunion Pod) — Feature 4
  // Only premium users can create a private pod
  isPrivate            Boolean     @default(false)
  inviteLink           String?     @unique  // shareable token for external invite link

  eventParticipants    EventParticipants[]
  messages             EventMessage[]
  eventTypes           EventEventType[]
  invites              PodInvite[]
  waitLists            WaitList[]

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model EventEventType {
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventTypeId String
  eventType   EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())

  @@id([eventId, eventTypeId])
}

model EventParticipants {
  id            String    @id @default(uuid())
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantId String
  user          User      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  role          EventRole
  joinedAt      DateTime  @default(now())

  // Journal entry submitted by host after event
  journalRating    Int?      // 1–5 star rating
  journalNoShow    Boolean   @default(false)
  journalSubmitted Boolean   @default(false)
  journalSubmittedAt DateTime?
}


model WaitList {
  id            String   @id @default(uuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt      DateTime @default(now())

  @@unique([eventId, userId])
}

// Private Pod invite — Feature 4
model PodInvite {
  id        String       @id @default(uuid())
  eventId   String
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviteeId String
  invitee   User         @relation(fields: [inviteeId], references: [id], onDelete: Cascade)
  status    InviteStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([eventId, inviteeId])
  @@index([inviteeId])
}

model EventType {
  id        String         @id @default(uuid())
  title     String
  thumbnail String
  events    EventEventType[]
  isDeleted Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([title])
}

// ─── Notifications ────────────────────────────────────────────────

model Notification {
  id                      String   @id @default(uuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationTitle       String
  notificationDescription String
  type                    NotificationType
  isRead                  Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt])
}

model Device {
  id        String @id @default(uuid())
  userId    String 
  fcmToken  String @unique
  platform  String // ios / android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Messaging ────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(uuid())
  userAId   String
  userA     User     @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages  Message[]
  settings  ConversationSettings[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model ConversationSettings {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clearedAt      DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  isEdited       Boolean      @default(false)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model EventMessage {
  id        String    @id @default(uuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User      @relation("SentEventMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  isEdited  Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([eventId, createdAt])
  @@index([senderId])
}



model UserTravelMode {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive        Boolean  @default(false)
  travelCityName  String?
  travelCityLat   Float?
  travelCityLong  Float?
  activatedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

}

model OrcaGraceToken {
  id             String           @id @default(uuid())
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  isUsed         Boolean          @default(false)
  usedAt         DateTime?
  resetsAt       DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}
