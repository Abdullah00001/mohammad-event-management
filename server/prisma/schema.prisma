generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  VIEW_ONLY
  HIBERNATED
  BLOCKED
}

enum Role {
  USER
  ADMIN
}

enum EventRole {
  HOST
  TRAVELER
}

enum Provider {
  MANUAL
  GOOGLE
  APPLE
}

enum Gender {
  MALE
  FEMALE
}

enum FriendshipStatus {
  ACCEPTED
  PENDING
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  DELETED
}

model User{
  id String @id @default(uuid())
  email String @unique
  password String?
  isVerified Boolean @default(false)
  accountStatus AccountStatus @default(ACTIVE)
  role Role @default(USER)
  provider Provider @default(MANUAL)
  providerId String?  
  strikeCount Int @default(0)
  penaltyEndDate DateTime?
  lastEventAttendedDate DateTime?
  isPremium Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sentRequests          Friends[]    @relation("SenderRelation")
  receivedRequests      Friends[]    @relation("ReceiverRelation")
  blockedUsers          BlockList[]   @relation("BlockerRelation")
  blockedBy             BlockList[]   @relation("BlockedRelation")
  profile Profile?
  userTraits UserTraits?
  userPreference UserPreference?
  eventParticipants EventParticipants[] 
  conversationsAsA     Conversation[]         @relation("ConversationUserA")
  conversationsAsB     Conversation[]         @relation("ConversationUserB")
  conversationSettings ConversationSettings[]
  sentMessages         Message[]              @relation("SentMessages")
  sentEventMessages    EventMessage[]         @relation("SentEventMessages")
  notifications         Notification[]
  @@index([role])
}

model Profile {
  id String @id @default(uuid())
  userId String @unique
  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
  name String?
  age Int?
  gender Gender?
  location String?
  avatar String?
  bio String?
  profileInterest String[] @default([])
  countryVisited String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Interest {
  id String @id @default(uuid())
  interestName String @unique
  interestIcon String
  isDeleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([interestName])
}


model UserTraits {
  id String @id @default(uuid())
  userId String @unique
  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
  energyScore Int
  curiosityScore Int
  rhythmScore Int
  createdAt DateTime @default(now())
  @@index([energyScore,curiosityScore,rhythmScore])
}

model UserPreference {
  id String @id @default(uuid())
  userId String @unique
  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
  pushNotification Boolean @default(true)
  emailNotification Boolean @default(true)
  eventReminders Boolean @default(true)
  friendRequest Boolean @default(true)
}

model Friends{
  id String @id @default(uuid())
  senderId String
  sender User @relation("SenderRelation",fields: [senderId],references: [id],onDelete: Cascade)
  status FriendshipStatus
  receiverId String
  receiver   User     @relation("ReceiverRelation", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([senderId, receiverId])
}

model BlockList{
  id String @id @default(uuid())
  blockerId String
  blocker User @relation("BlockerRelation",fields: [blockerId],references: [id],onDelete: Cascade)
  blockedUserId String
  blockedUser   User     @relation("BlockedRelation", fields: [blockedUserId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([blockerId, blockedUserId])
}

model Event { 
  id String @id @default(uuid())
  eventName String
  description String
  startDate DateTime
  startTime String
  maxParticipantsCount Int @default(10)
  eventStatus EventStatus @default(UPCOMING)
  lat Float
  long Float
  deletedAt DateTime?
  activityTypes String[] @default([])
  eventParticipants EventParticipants[]
  messages EventMessage[]
  eventTypes EventEventType[] 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventEventType {
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventTypeId String
  eventType   EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())

  @@id([eventId, eventTypeId])
}

model EventParticipants {
  id String @id @default(uuid())
  eventId       String
  event         Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantId String
  user          User       @relation(fields: [participantId], references: [id], onDelete: Cascade)
  role EventRole
  joinedAt DateTime @default(now())
}

model Notification {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
  notificationTitle String
  notificationDescription String
  isRead Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

// ─── 1-to-1 Friend Chat ───────────────────────────────────────────

model Conversation {
  id        String   @id @default(uuid())
  userAId   String
  userA     User     @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages  Message[]
  settings  ConversationSettings[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

// Per-user settings: powers "clear chat" and "delete conversation"
model ConversationSettings {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Clear chat (one-sided): user only sees messages sent AFTER this timestamp
  clearedAt      DateTime?

  // Delete conversation (one-sided): hide this chat from user's inbox entirely
  deletedAt      DateTime?

  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  isEdited       Boolean      @default(false)

  // Soft delete: sender can unsend/delete their own message
  deletedAt      DateTime?

  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ─── Event Group Chat ─────────────────────────────────────────────

model EventMessage {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("SentEventMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  isEdited  Boolean  @default(false)

  // Soft delete: host or sender can remove a message
  deletedAt DateTime?

  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([senderId])
}

model EventType {
  id String @id @default(uuid())
  title String
  thumbnail String
  events EventEventType[] 
  isDeleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([title])
}